# Copiar a .env.local y rellenar. Nunca subir .env.local.
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Interruptor de la IA. Apagada por defecto: no se hace ninguna llamada a Claude hasta que el equipo diga "true".
AI_ENABLED=false
# Modo demo: /demo y /dev/sesion (entrar como usuarios de ejemplo). true en desarrollo y para el pitch; false en producción real.
DEMO_MODE=true
